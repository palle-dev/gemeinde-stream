{
  "name": "OrganizationMember",
  "type": "object",
  "properties": {
    "organization_id": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "display_name": { "type": "string", "maxLength": 120 },
    "role": { "type": "string", "enum": ["admin", "producer", "operator", "member"], "default": "member" },
    "status": { "type": "string", "enum": ["invited", "active", "disabled"], "default": "invited" }
  },
  "required": ["organization_id", "email", "display_name", "role", "status"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "$or": [{ "data.email": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
