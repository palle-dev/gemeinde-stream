{
  "name": "Event",
  "type": "object",
  "properties": {
    "organization_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "mode": { "type": "string", "enum": ["meeting", "broadcast"], "default": "meeting" },
    "status": { "type": "string", "enum": ["scheduled", "live", "ended"], "default": "scheduled" },
    "starts_at": { "type": "string", "format": "date-time" },
    "duration_minutes": { "type": "integer", "minimum": 15, "maximum": 1440, "default": 60 },
    "recurrence_group_id": { "type": "string" },
    "recurrence_frequency": { "type": "string", "enum": ["weekly", "biweekly", "monthly"] },
    "recurrence_index": { "type": "integer", "minimum": 0 },
    "recurrence_count": { "type": "integer", "minimum": 2, "maximum": 52 },
    "host_email": { "type": "string", "format": "email" },
    "join_code": { "type": "string", "minLength": 6, "maxLength": 12 },
    "livekit_room_name": { "type": "string" },
    "max_participants": { "type": "integer", "minimum": 2, "maximum": 500, "default": 50 },
    "default_camera_on": { "type": "boolean", "default": true },
    "default_microphone_on": { "type": "boolean", "default": true },
    "waiting_room_enabled": { "type": "boolean", "default": true },
    "meeting_locked": { "type": "boolean", "default": false },
    "meeting_spotlight_key": { "type": "string", "maxLength": 240, "default": "" },
    "meeting_spotlight_revision": { "type": "integer", "minimum": 0, "default": 0 },
    "meeting_spotlight_updated_at": { "type": "string", "format": "date-time" },
    "broadcast_controller_identity": { "type": "string", "maxLength": 200, "default": "" },
    "broadcast_controller_device_id": { "type": "string", "maxLength": 100, "default": "" },
    "broadcast_controller_name": { "type": "string", "maxLength": 80, "default": "" },
    "broadcast_controller_lease_expires_at": { "type": "string", "format": "date-time" },
    "broadcast_controller_revision": { "type": "integer", "minimum": 0, "default": 0 },
    "broadcast_program_state": { "type": "object", "default": {} },
    "recording_enabled": { "type": "boolean", "default": false },
    "streaming_enabled": { "type": "boolean", "default": false },
    "reminders_enabled": { "type": "boolean", "default": true },
    "calendar_sequence": { "type": "integer", "minimum": 0, "default": 0 },
    "host_reminder_24h_for_start": { "type": "string", "format": "date-time" },
    "host_reminder_1h_for_start": { "type": "string", "format": "date-time" }
  },
  "required": ["title", "mode", "host_email", "join_code", "livekit_room_name"],
  "rls": {
    "create": { "data.host_email": "{{user.email}}" },
    "read": { "$or": [{ "data.host_email": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] },
    "update": { "$or": [{ "data.host_email": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] },
    "delete": { "$or": [{ "data.host_email": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] }
  }
}
