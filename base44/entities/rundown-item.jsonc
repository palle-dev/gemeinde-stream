{
  "name": "RundownItem",
  "type": "object",
  "properties": {
    "event_id": { "type": "string" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "notes": { "type": "string", "maxLength": 1000 },
    "kind": { "type": "string", "enum": ["welcome", "music", "speech", "prayer", "media", "announcement", "other"], "default": "other" },
    "position": { "type": "integer", "minimum": 0 },
    "duration_seconds": { "type": "integer", "minimum": 0, "maximum": 14400, "default": 300 },
    "status": { "type": "string", "enum": ["pending", "live", "done"], "default": "pending" }
  },
  "required": ["event_id", "title", "kind", "position", "duration_seconds", "status"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
