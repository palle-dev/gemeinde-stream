{
  "name": "Scene",
  "type": "object",
  "properties": {
    "event_id": { "type": "string" },
    "owner_email": { "type": "string", "format": "email" },
    "name": { "type": "string" },
    "layout": { "type": "string", "enum": ["single", "side_by_side", "grid", "picture_in_picture"], "default": "single" },
    "source_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": { "type": "integer" },
          "participant_identity": { "type": "string" },
          "track_source": { "type": "string" }
        }
      }
    },
    "overlay_title": { "type": "string", "maxLength": 80, "default": "" },
    "overlay_subtitle": { "type": "string", "maxLength": 120, "default": "" },
    "audio_mix": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
      "default": {}
    },
    "media_cue_seconds": { "type": "number", "minimum": 0, "maximum": 86400, "default": 0 },
    "media_autoplay": { "type": "boolean", "default": true },
    "sort_order": { "type": "integer", "minimum": 0, "default": 0 },
    "is_program": { "type": "boolean", "default": false }
  },
  "required": ["event_id", "owner_email", "name", "layout"],
  "rls": {
    "create": { "data.owner_email": "{{user.email}}" },
    "read": { "$or": [{ "data.owner_email": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] },
    "update": { "$or": [{ "data.owner_email": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] },
    "delete": { "$or": [{ "data.owner_email": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] }
  }
}
