{
  "name": "MeetingFile",
  "type": "object",
  "properties": {
    "event_id": { "type": "string" },
    "file_id": { "type": "string", "maxLength": 100 },
    "name": { "type": "string", "maxLength": 180 },
    "file_url": { "type": "string", "format": "uri" },
    "file_uri": { "type": "string", "maxLength": 2048 },
    "mime_type": { "type": "string", "maxLength": 100 },
    "size_bytes": { "type": "integer", "minimum": 1, "maximum": 26214400 },
    "uploaded_by": { "type": "string", "format": "email" },
    "uploaded_by_name": { "type": "string", "maxLength": 80 },
    "uploaded_at": { "type": "string", "format": "date-time" }
  },
  "required": ["event_id", "file_id", "name", "size_bytes", "uploaded_by", "uploaded_by_name", "uploaded_at"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
