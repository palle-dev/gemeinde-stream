{
  "name": "gemeinde-stream",
  "version": "0.3.0",
  "private": true,
  "description": "Steuerungs- und Streaming-Plattform fuer Gemeinde-Veranstaltungen",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @gemeinde-stream/desktop",
    "dist:win": "npm run dist:win --workspace @gemeinde-stream/desktop",
    "dist:mac": "npm run dist:mac --workspace @gemeinde-stream/desktop",
    "electron:setup": "npm run electron:setup --workspace @gemeinde-stream/desktop",
    "dev": "npm run dev --workspace @gemeinde-stream/desktop",
    "dev:local": "npm run livekit:start && npm run dev",
    "livekit:setup": "node scripts/livekit-local.mjs Setup",
    "livekit:start": "node scripts/livekit-local.mjs Start",
    "livekit:stop": "node scripts/livekit-local.mjs Stop",
    "livekit:status": "node scripts/livekit-local.mjs Status",
    "livekit:smoke": "node scripts/livekit-local.mjs Smoke",
    "stream:smoke": "node scripts/rtmp-smoke.mjs",
    "base44:deploy:functions": "node scripts/deploy-base44-functions.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "base44": "0.1.5",
    "livekit-server-sdk": "^2.19.2"
  }
}
