{
  "name": "gemeinde-stream",
  "version": "0.2.0",
  "private": true,
  "description": "Steuerungs- und Streaming-Plattform fuer Gemeinde-Veranstaltungen",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @gemeinde-stream/desktop",
    "dist:win": "npm run dist:win --workspace @gemeinde-stream/desktop",
    "dev": "npm run dev --workspace @gemeinde-stream/desktop",
    "dev:local": "npm run livekit:start && npm run dev",
    "livekit:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/livekit-local.ps1 Setup",
    "livekit:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/livekit-local.ps1 Start",
    "livekit:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/livekit-local.ps1 Stop",
    "livekit:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/livekit-local.ps1 Status",
    "livekit:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/livekit-local.ps1 Smoke",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "base44": "^0.2.2",
    "livekit-server-sdk": "^2.19.2"
  }
}
